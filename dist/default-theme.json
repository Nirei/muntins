{
    "tokens": {
        "fg": "#dce1de",
        "bg": "#1f2421",
        "primary": "#216869",
        "accent": "#49a078",
        "muted": "#9cc5a1",
        "surface": "#2e3532",
        "error": "#c45d5d"
    },
    "root": { "backgroundColor": "$bg", "color": "$fg" },
    "switch": { "checkedChar": " ■", "uncheckedChar": "■ ", "inverse": true },
    "switch--checked": { "color": "$accent" },
    "switch--unchecked": { "color": "$error" },
    "switch--disabled": { "dim": true },
    "radio-group": {
        "flexDirection": "row",
        "selectedChar": "●",
        "unselectedChar": "○"
    },
    "radio-group--label": { "color": "$muted" },
    "radio-group--focused": { "color": "$accent" },
    "radio-group--disabled": { "dim": true, "color": "$muted" },
    "select--dropdown": {
        "backgroundColor": "$surface",
        "paddingStart": 1,
        "paddingEnd": 1
    },
    "select--dropdown--highlight": {
        "backgroundColor": "$primary"
    },
    "select--indicator": { "openChar": "▲", "closedChar": "▼" },
    "select--disabled": { "dim": true },
    "select--focused": { "backgroundColor": "$primary" },
    "textarea": { "width": 40 },
    "textarea--cursor": { "inverse": true },
    "textarea--placeholder": { "dim": true },
    "textarea--disabled": { "dim": true },
    "input": {
        "width": 20,
        "backgroundColor": "$surface",
        "paddingStart": 1,
        "paddingEnd": 1
    },
    "progress": {
        "width": 20,
        "chars": [" ", "▏", "▎", "▍", "▌", "▋", "▊", "▉", "█"]
    },
    "spinner": { "interval": 80 },
    "spinner--dots": {
        "frames": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    },
    "spinner--line": { "frames": ["-", "\\", "|", "/"] },
    "spinner--arc": { "frames": ["◜", "◠", "◝", "◞", "◡", "◟"] },
    "toast": { "duration": 3000 },
    "drawer": { "side": "right", "size": 30 },
    "menubar": {
        "gap": 2,
        "backgroundColor": "$primary",
        "paddingStart": 1,
        "paddingEnd": 1
    },
    "menubar--item--hover": { "inverse": true },
    "menubar--separator": { "content": "──────────" },
    "button": {
        "backgroundColor": "$surface",
        "paddingStart": 1,
        "paddingEnd": 1
    },
    "button--focused": { "backgroundColor": "$primary" },
    "button--hover": { "backgroundColor": "$primary" },
    "label": { "color": "$muted" },
    "label--focused": { "color": "$accent" },
    "separator": { "borderColor": "$surface" },
    "heading": { "bold": true, "borderColor": "$surface" },
    "heading--h1": { "color": "$accent" },
    "heading--h2": { "color": "$accent" },
    "heading--h3": { "color": "$muted" },
    "heading--h4": { "color": "$muted" },
    "heading--h5": { "color": "$muted" },
    "heading--h6": { "color": "$muted" },
    "blockquote": { "color": "$muted", "borderColor": "$primary" },
    "code": { "color": "$accent" },
    "code-block": { "backgroundColor": "$surface", "color": "$accent" },
    "list": { "markerChar": "•", "markers": ["•", "◦", "▪"] },
    "list--ordered": {},
    "list--marker": { "color": "$muted" },
    "list--task-checked": { "checkedChar": "☑", "uncheckedChar": "☐" },
    "table": { "borderColor": "$surface" },
    "table--header": { "bold": true },
    "link": { "color": "$accent", "underline": true },
    "image": { "color": "$muted" },
    "markdown": { "gap": 1 }
}
