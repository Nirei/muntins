{
  "tokens": {
    "bg": "#1f2421",
    "primary": "#216869",
    "accent": "#49a078",
    "muted": "#9cc5a1",
    "fg": "#dce1de",
    "surface": "#2e3532",
    "error": "#c45d5d"
  },
  "root": { "backgroundColor": "$bg", "color": "$fg" },
  "switch": { "checkedChar": " ■", "uncheckedChar": "■ ", "inverse": true },
  "switch--checked": { "color": "$accent" },
  "switch--unchecked": { "color": "$error" },
  "switch--disabled": { "dim": true },
  "radio-group": { "flexDirection": "row", "selectedChar": "●", "unselectedChar": "○" },
  "radio-group--label": { "color": "$muted" },
  "radio-group--disabled": { "dim": true, "color": "$muted" },
  "select--dropdown": { "backgroundColor": "$surface", "paddingStart": 1, "paddingEnd": 1 },
  "select--indicator": { "openChar": "▲", "closedChar": "▼" },
  "select--disabled": { "dim": true },
  "textarea": { "width": 40 },
  "textarea--cursor": { "inverse": true },
  "textarea--placeholder": { "dim": true },
  "textarea--disabled": { "dim": true },
  "input": { "width": 20, "backgroundColor": "$surface", "paddingStart": 1, "paddingEnd": 1 },
  "progress": { "width": 20, "chars": [" ", "▏", "▎", "▍", "▌", "▋", "▊", "▉", "█"] },
  "spinner": { "interval": 80 },
  "spinner--dots": { "frames": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"] },
  "spinner--line": { "frames": ["-", "\\", "|", "/"] },
  "spinner--arc": { "frames": ["◜", "◠", "◝", "◞", "◡", "◟"] },
  "toast": { "duration": 3000 },
  "drawer": { "side": "right", "size": 30 },
  "menubar--separator": { "content": "──────────" },
  "menubar--item": { "gap": 2 },
  "button": { "backgroundColor": "$surface", "paddingStart": 1, "paddingEnd": 1 },
  "button--hover": { "backgroundColor": "$primary" },
  "label": { "color": "$muted" },
  "separator": { "borderColor": "$surface" }
}
